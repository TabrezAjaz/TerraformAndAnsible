[webservers]
web ansible_host=${web_public_ip} ansible_user=ubuntu ansible_ssh_private_key_file=${private_key_path} web_private_ip=${web_private_ip} db_private_ip=${db_private_ip} admin_cidr=${admin_cidr}

[dbservers]
database ansible_host=${db_private_ip} ansible_user=ubuntu ansible_ssh_private_key_file=${private_key_path} web_private_ip=${web_private_ip} db_private_ip=${db_private_ip} ansible_ssh_common_args='-o ProxyCommand="ssh -W %h:%p -q -i ${private_key_path} -o StrictHostKeyChecking=no ubuntu@${web_public_ip}"'

[all:vars]
ansible_python_interpreter=/usr/bin/python3
